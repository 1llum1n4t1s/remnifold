{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^mcp__remnifold__",
        "hooks": [
          {
            "type": "command",
            "command": "cargo run --quiet --locked --manifest-path \"${PLUGIN_ROOT}/native/Cargo.toml\" -- hook PreToolUse",
            "timeout": 5,
            "statusMessage": "Checking memory access..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cargo run --quiet --locked --manifest-path \"${PLUGIN_ROOT}/native/Cargo.toml\" -- hook SessionStart",
            "timeout": 30,
            "statusMessage": "Loading memory index..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cargo run --quiet --locked --manifest-path \"${PLUGIN_ROOT}/native/Cargo.toml\" -- hook UserPromptSubmit",
            "timeout": 12,
            "statusMessage": "Searching memory index..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cargo run --quiet --locked --manifest-path \"${PLUGIN_ROOT}/native/Cargo.toml\" -- hook Stop",
            "timeout": 120,
            "async": true,
            "statusMessage": "Saving memory index..."
          }
        ]
      }
    ]
  }
}
