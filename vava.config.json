{
  "localPlugin": {
    "id": "remnifold@personal",
    "repository": "1llum1n4t1s/remnifold",
    "workflow": "CI",
    "artifact": "remnifold",
    "sourcePath": "~/plugins/remnifold",
    "ready": "node scripts/update-local-plugin.mjs --version {{NEW_VERSION}} --check-published",
